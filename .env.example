SPRING_PROFILES_ACTIVE=dev
PORT=8080

POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=jdbc:postgresql://localhost:5432/waypoint
DATABASE_USERNAME=waypoint
DATABASE_PASSWORD=replace-with-a-random-database-password
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2
DATABASE_CONNECTION_TIMEOUT_MS=30000
DATABASE_VALIDATION_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379

ADMIN_ID=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_TOTP_SECRET=replace-with-a-base32-totp-secret
WAYPOINT_ADMIN_EMAIL=

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_SECONDS=900
WAYPOINT_SESSION_REFRESH_TOKEN_TTL_SECONDS=2592000
WAYPOINT_SESSION_CLEANUP_MS=3600000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_TOKEN_INFO_URL=https://oauth2.googleapis.com/tokeninfo
GOOGLE_USER_INFO_URL=https://openidconnect.googleapis.com/v1/userinfo

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CALLBACK_URL=http://localhost:8080/api/v1/auth/microsoft/callback
MICROSOFT_GRAPH_USER_URL=https://graph.microsoft.com/v1.0/me?$select=id,displayName,mail,userPrincipalName
# Development only. Production must unset this and mount a managed secret file instead.
MICROSOFT_TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
MICROSOFT_TOKEN_ENCRYPTION_KEY_FILE=
MICROSOFT_ALLOWED_EXTENSION_REDIRECT_URIS=https://local-dev.chromiumapp.org/microsoft
MICROSOFT_TRANSACTION_TTL_SECONDS=600
MICROSOFT_EXCHANGE_CODE_TTL_SECONDS=180
MICROSOFT_OAUTH_CLEANUP_MS=3600000

LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_MONTHLY_VARIANT_ID=your-monthly-variant-id
LEMON_SQUEEZY_ANNUAL_VARIANT_ID=your-annual-variant-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMON_SQUEEZY_API_BASE_URL=https://api.lemonsqueezy.com/v1

AI_OPENAI_ENABLED=false
AI_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-5-nano
AI_OPENAI_REQUEST_TIMEOUT=30s
# Development only. Replace with a separate random Base64-encoded 32-byte key in production.
AI_BYOK_ENCRYPTION_KEY=d2F5cG9pbnQtYnlvay1kZXYta2V5LTMyLWJ5dGVzISE=

CORS_ALLOWED_ORIGINS=chrome-extension://your-extension-id,http://localhost:5173
APP_BASE_URL=http://localhost:8080

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_WAYPOINT=DEBUG
