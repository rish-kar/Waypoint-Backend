{"info":{"_postman_id":"aa93dc55-52d9-4b40-84f0-0d397a7301a8","name":"Waypoint Backend API","description":"Run folders in order. Health checks need only the backend and PostgreSQL. Google Login requires a real Google access token and a matching backend GOOGLE_CLIENT_ID. Checkout requests require Lemon Squeezy test-mode credentials. Webhook requests generate X-Signature automatically from webhookSecret.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('baseUrl')) {","    throw new Error('Select the Waypoint Local environment.');","}"]}}],"item":[{"name":"00 - Health and Configuration","item":[{"name":"Health","request":{"method":"GET","header":[{"key":"X-Request-ID","value":"postman-health"}],"url":{"raw":"{{baseUrl}}/actuator/health","host":["{{baseUrl}}"],"path":["actuator","health"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Health is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));","pm.test('Request ID returned', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-health'));" ]}}]},{"name":"Liveness","request":{"method":"GET","header":[{"key":"X-Request-ID","value":"postman-liveness"}],"url":{"raw":"{{baseUrl}}/actuator/health/liveness","host":["{{baseUrl}}"],"path":["actuator","health","liveness"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Health is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));","pm.test('Request ID returned', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-liveness'));" ]}}]},{"name":"Readiness","request":{"method":"GET","header":[{"key":"X-Request-ID","value":"postman-readiness"}],"url":{"raw":"{{baseUrl}}/actuator/health/readiness","host":["{{baseUrl}}"],"path":["actuator","health","readiness"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Health is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));","pm.test('Request ID returned', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-readiness'));" ]}}]}]},{"name":"01 - Authentication","item":[{"name":"Google Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"accessToken\": \"{{googleAccessToken}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/v1/auth/google","host":["{{baseUrl}}"],"path":["api","v1","auth","google"]},"description":"Saves jwt and userId into the selected environment."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.test('Bearer token returned', () => {","    pm.expect(body.tokenType).to.eql('Bearer');","    pm.expect(body.accessToken).to.be.a('string').and.not.empty;","});","pm.environment.set('jwt', body.accessToken);","pm.environment.set('userId', body.user.id);" ]}}]},{"name":"Google Login - Missing Token","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"accessToken\": \"\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/v1/auth/google","host":["{{baseUrl}}"],"path":["api","v1","auth","google"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 400', () => pm.response.to.have.status(400));" ]}}]},{"name":"Protected Endpoint - No JWT","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/v1/me","host":["{{baseUrl}}"],"path":["api","v1","me"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 401', () => pm.response.to.have.status(401));","pm.test('Unauthorized code returned', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));" ]}}]}]},{"name":"02 - Account and Entitlements","item":[{"name":"Current User","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{jwt}}"}],"url":{"raw":"{{baseUrl}}/api/v1/me","host":["{{baseUrl}}"],"path":["api","v1","me"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.test('User ID matches login', () => pm.expect(body.id).to.eql(pm.environment.get('userId')));","pm.test('Entitlement included', () => pm.expect(body.entitlement.features).to.be.an('array'));" ]}}]},{"name":"Current Entitlements","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{jwt}}"}],"url":{"raw":"{{baseUrl}}/api/v1/entitlements","host":["{{baseUrl}}"],"path":["api","v1","entitlements"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.test('Valid plan', () => pm.expect(body.plan).to.be.oneOf(['FREE', 'PREMIUM']));","pm.test('Features returned', () => pm.expect(body.features).to.be.an('array').and.not.empty);" ]}}]}]},{"name":"03 - Billing","item":[{"name":"Billing Status","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{jwt}}"}],"url":{"raw":"{{baseUrl}}/api/v1/billing/status","host":["{{baseUrl}}"],"path":["api","v1","billing","status"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Valid plan', () => pm.expect(pm.response.json().plan).to.be.oneOf(['FREE', 'PREMIUM']));" ]}}]},{"name":"Create Monthly Checkout","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{jwt}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/v1/billing/checkout","host":["{{baseUrl}}"],"path":["api","v1","billing","checkout"]},"body":{"mode":"raw","raw":"{\n  \"plan\": \"MONTHLY\"\n}","options":{"raw":{"language":"json"}}},"description":"Requires valid Lemon Squeezy test-mode configuration."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Checkout URL returned', () => pm.expect(pm.response.json().checkoutUrl).to.match(/^https:\\/\\//));" ]}}]},{"name":"Create Annual Checkout","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{jwt}}"},{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/v1/billing/checkout","host":["{{baseUrl}}"],"path":["api","v1","billing","checkout"]},"body":{"mode":"raw","raw":"{\n  \"plan\": \"ANNUAL\"\n}","options":{"raw":{"language":"json"}}},"description":"Requires valid Lemon Squeezy test-mode configuration."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Checkout URL returned', () => pm.expect(pm.response.json().checkoutUrl).to.match(/^https:\\/\\//));" ]}}]}]},{"name":"04 - Webhooks","description":"Run after Google Login so userId exists. webhookSecret and monthlyVariantId must match the running backend.","item":[{"name":"Invalid Signature","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["let CryptoJS;","try {","    CryptoJS = pm.require('npm:crypto-js@4.2.0');","} catch (error) {","    CryptoJS = require('crypto-js');","}","const secret = pm.environment.get('webhookSecret');","if (!secret) {","    throw new Error('Set webhookSecret in the environment.');","}","const payload = JSON.stringify({","  meta: {","    event_name: 'subscription_created',","    custom_data: { waypoint_user_id: pm.environment.get('userId'), waypoint_plan: 'MONTHLY' }","  },","  data: {","    type: 'subscriptions',","    id: pm.environment.get('subscriptionId'),","    attributes: {","      customer_id: 'postman-customer',","      product_id: 'postman-product',","      variant_id: pm.environment.get('monthlyVariantId'),","      status: 'active',","      renews_at: '2030-01-01T00:00:00Z',","      ends_at: null","    }","  }","});","pm.variables.set('webhookBody', payload);","pm.variables.set('webhookSignature', CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex));" ]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 401', () => pm.response.to.have.status(401));" ]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Signature","value":"bad-signature"}],"body":{"mode":"raw","raw":"{{webhookBody}}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/v1/webhooks/lemonsqueezy","host":["{{baseUrl}}"],"path":["api","v1","webhooks","lemonsqueezy"]},"description":"Confirms that unsigned or incorrectly signed payloads are rejected."}},{"name":"Activate Monthly Subscription","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["let CryptoJS;","try {","    CryptoJS = pm.require('npm:crypto-js@4.2.0');","} catch (error) {","    CryptoJS = require('crypto-js');","}","const secret = pm.environment.get('webhookSecret');","if (!secret) {","    throw new Error('Set webhookSecret in the environment.');","}","const payload = JSON.stringify({","  meta: {","    event_name: 'subscription_created',","    custom_data: { waypoint_user_id: pm.environment.get('userId'), waypoint_plan: 'MONTHLY' }","  },","  data: {","    type: 'subscriptions',","    id: pm.environment.get('subscriptionId'),","    attributes: {","      customer_id: 'postman-customer',","      product_id: 'postman-product',","      variant_id: pm.environment.get('monthlyVariantId'),","      status: 'active',","      renews_at: '2030-01-01T00:00:00Z',","      ends_at: null","    }","  }","});","pm.variables.set('webhookBody', payload);","pm.variables.set('webhookSignature', CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex));" ]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));" ]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Signature","value":"{{webhookSignature}}"}],"body":{"mode":"raw","raw":"{{webhookBody}}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/v1/webhooks/lemonsqueezy","host":["{{baseUrl}}"],"path":["api","v1","webhooks","lemonsqueezy"]},"description":"Creates or updates an ACTIVE subscription for the logged-in user."}},{"name":"Verify Premium Entitlement","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{jwt}}"}],"url":{"raw":"{{baseUrl}}/api/v1/entitlements","host":["{{baseUrl}}"],"path":["api","v1","entitlements"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.test('Premium is enabled', () => pm.expect(body.premium).to.eql(true));","pm.test('Plan is PREMIUM', () => pm.expect(body.plan).to.eql('PREMIUM'));" ]}}]},{"name":"Refund Subscription","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["let CryptoJS;","try {","    CryptoJS = pm.require('npm:crypto-js@4.2.0');","} catch (error) {","    CryptoJS = require('crypto-js');","}","const secret = pm.environment.get('webhookSecret');","if (!secret) {","    throw new Error('Set webhookSecret in the environment.');","}","const subscriptionId = pm.environment.get('subscriptionId');","const payload = JSON.stringify({","  meta: {","    event_name: 'subscription_payment_refunded',","    custom_data: { waypoint_user_id: pm.environment.get('userId'), waypoint_plan: 'MONTHLY' }","  },","  data: {","    type: 'subscription-invoices',","    id: `subinv_${subscriptionId}`,","    attributes: {","      subscription_id: subscriptionId,","      customer_id: 'postman-customer',","      status: 'refunded'","    }","  }","});","pm.variables.set('webhookBody', payload);","pm.variables.set('webhookSignature', CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex));" ]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));" ]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Signature","value":"{{webhookSignature}}"}],"body":{"mode":"raw","raw":"{{webhookBody}}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/v1/webhooks/lemonsqueezy","host":["{{baseUrl}}"],"path":["api","v1","webhooks","lemonsqueezy"]},"description":"Marks the same subscription as REFUNDED."}},{"name":"Verify Free Entitlement After Refund","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{jwt}}"}],"url":{"raw":"{{baseUrl}}/api/v1/entitlements","host":["{{baseUrl}}"],"path":["api","v1","entitlements"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.test('Premium is disabled', () => pm.expect(body.premium).to.eql(false));","pm.test('Plan is FREE', () => pm.expect(body.plan).to.eql('FREE'));" ]}}]}]}]}