{
  "info": {
    "_postman_id": "d48cf568-cf11-4a66-97a7-bf499f72f42f",
    "name": "Waypoint Authentication API",
    "description": "Authentication-only verification for the Authentication branch. Run requests in order. Successful Google Login requires a real Google access token whose audience matches GOOGLE_CLIENT_ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) {",
          "    throw new Error('Select the Waypoint Authentication Local environment.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Request Validation",
      "item": [
        {
          "name": "Google Login - Missing Body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "google"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Invalid request code returned', () => pm.expect(pm.response.json().code).to.eql('INVALID_REQUEST'));"
            ] }
          }]
        },
        {
          "name": "Google Login - Blank Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accessToken\": \"\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "google"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Invalid request code returned', () => pm.expect(pm.response.json().code).to.eql('INVALID_REQUEST'));"
            ] }
          }]
        },
        {
          "name": "Public Login Route Ignores Invalid Authorization Header",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "NotBearer invalid" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "google"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Public route reaches request validation', () => pm.response.to.have.status(400));"
            ] }
          }]
        }
      ]
    },
    {
      "name": "01 - Google Login",
      "item": [
        {
          "name": "Successful Google Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-ID", "value": "postman-auth-login" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"accessToken\": \"{{googleAccessToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "google"] },
            "description": "Requires a real Google access token whose audience matches GOOGLE_CLIENT_ID."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Bearer token returned', () => {",
              "    pm.expect(body.tokenType).to.eql('Bearer');",
              "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "    pm.expect(body.expiresIn).to.be.above(0);",
              "});",
              "pm.test('Request ID propagated', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-auth-login'));",
              "pm.environment.set('jwt', body.accessToken);",
              "pm.environment.set('userId', body.user.id);"
            ] }
          }]
        },
        {
          "name": "Invalid Google Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accessToken\": \"invalid-google-access-token\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "google"] },
            "description": "Requires network access from the backend to Google."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('Generic authentication failure returned', () => {",
              "    pm.expect(body.code).to.eql('UNAUTHORIZED');",
              "    pm.expect(body.message).to.eql('Google authentication failed');",
              "});"
            ] }
          }]
        }
      ]
    },
    {
      "name": "02 - Bearer Authentication",
      "item": [
        {
          "name": "Protected Endpoint - Missing Bearer Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "pm.test('Authentication required', () => pm.expect(pm.response.json().message).to.eql('Authentication required'));"
            ] }
          }]
        },
        {
          "name": "Protected Endpoint - Invalid Scheme",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token invalid" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "pm.test('Generic bearer failure returned', () => pm.expect(pm.response.json().message).to.eql('Invalid or expired bearer token'));"
            ] }
          }]
        },
        {
          "name": "Protected Endpoint - Malformed JWT",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid-token" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "pm.test('Unauthorized code returned', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
            ] }
          }]
        },
        {
          "name": "Protected Endpoint - Expired Signed JWT",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "let CryptoJS;",
                "try {",
                "    CryptoJS = pm.require('npm:crypto-js@4.2.0');",
                "} catch (error) {",
                "    CryptoJS = require('crypto-js');",
                "}",
                "const secret = pm.environment.get('jwtSecret');",
                "if (!secret) {",
                "    throw new Error('Set jwtSecret to the JWT_SECRET used by the backend.');",
                "}",
                "const base64Url = (value) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(value))",
                "    .replace(/=+$/g, '')",
                "    .replace(/\\+/g, '-')",
                "    .replace(/\\//g, '_');",
                "const signatureBase64Url = (value) => CryptoJS.enc.Base64.stringify(value)",
                "    .replace(/=+$/g, '')",
                "    .replace(/\\+/g, '-')",
                "    .replace(/\\//g, '_');",
                "const now = Math.floor(Date.now() / 1000);",
                "const header = base64Url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
                "const payload = base64Url(JSON.stringify({",
                "    iss: 'waypoint-backend',",
                "    aud: 'waypoint-extension',",
                "    sub: '00000000-0000-0000-0000-000000000001',",
                "    email: 'expired@example.com',",
                "    jti: '00000000-0000-0000-0000-000000000002',",
                "    iat: now - 7200,",
                "    nbf: now - 7200,",
                "    exp: now - 3600",
                "}));",
                "const signingInput = `${header}.${payload}`;",
                "const signature = signatureBase64Url(CryptoJS.HmacSHA256(signingInput, secret));",
                "pm.variables.set('expiredJwt', `${signingInput}.${signature}`);"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                "pm.test('Expired token is generic to client', () => pm.expect(pm.response.json().message).to.eql('Invalid or expired bearer token'));"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{expiredJwt}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] },
            "description": "The pre-request script signs an already expired JWT using jwtSecret."
          }
        },
        {
          "name": "Current User - Valid JWT",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('User matches login', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('userId')));"
            ] }
          }]
        }
      ]
    }
  ]
}
