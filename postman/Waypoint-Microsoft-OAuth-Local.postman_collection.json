{
  "info": {
    "_postman_id": "7df5b6ce-1a4a-44b8-97d3-bd07d9897617",
    "name": "Waypoint Microsoft OAuth - Local E2E",
    "description": "Local end-to-end helper for Waypoint Microsoft OAuth. Configure the backend with a real local Microsoft/Azure app registration, set microsoftRedirectUri to the exact allowlisted Chrome identity redirect URI, then run Microsoft Start. Open the saved authorizationUrl through the Chrome extension web-auth flow. After Microsoft redirects back to the extension, copy the exchange_code query parameter into exchangeCode and continue with Session Exchange. Microsoft browser consent cannot be automated safely from Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "microsoftRedirectUri", "value": "https://your-extension-id.chromiumapp.org/microsoft" },
    { "key": "authorizationUrl", "value": "" },
    { "key": "exchangeCode", "value": "" },
    { "key": "jwt", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "oldRefreshToken", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Microsoft Start",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Authorization URL returned', () => pm.expect(body.authorizationUrl).to.be.a('string').and.not.empty);",
              "pm.test('PKCE is enabled', () => pm.expect(body.authorizationUrl).to.include('code_challenge='));",
              "pm.collectionVariables.set('authorizationUrl', body.authorizationUrl);",
              "console.log('Open this URL through the Chrome extension web-auth flow:', body.authorizationUrl);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Request-ID", "value": "postman-ms-start" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"redirectUri\": \"{{microsoftRedirectUri}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/microsoft/start",
        "description": "Starts Microsoft OAuth. Open the returned authorizationUrl in the extension web-auth flow. After successful consent, copy exchange_code from the final extension redirect into the exchangeCode collection variable."
      }
    },
    {
      "name": "02 - Session Exchange",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Waypoint access token returned', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('Waypoint refresh token returned', () => pm.expect(body.refreshToken).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('jwt', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "pm.collectionVariables.set('userId', body.user.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"exchangeCode\": \"{{exchangeCode}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/session/exchange",
        "description": "Exchanges the short-lived one-time exchange code for Waypoint access and refresh tokens."
      }
    },
    {
      "name": "03 - Protected Account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{jwt}}" } ],
        "url": "{{baseUrl}}/api/v1/account",
        "description": "Confirms the Waypoint access token works on a protected endpoint."
      }
    },
    {
      "name": "04 - Current Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Session is signed in', () => pm.expect(body.signedIn).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{jwt}}" } ],
        "url": "{{baseUrl}}/api/v1/auth/session"
      }
    },
    {
      "name": "05 - Refresh Session",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('refreshToken'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Refresh token rotated', () => pm.expect(body.refreshToken).to.not.eql(pm.collectionVariables.get('oldRefreshToken')));",
              "pm.collectionVariables.set('jwt', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/session/refresh"
      }
    },
    {
      "name": "06 - Reject Replayed Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{oldRefreshToken}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/session/refresh"
      }
    },
    {
      "name": "07 - Microsoft Link Start",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('authorizationUrl', body.authorizationUrl);",
              "console.log('Open this URL to explicitly link Microsoft to the currently authenticated Waypoint account:', body.authorizationUrl);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"redirectUri\": \"{{microsoftRedirectUri}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/microsoft/link/start",
        "description": "Use this when testing explicit Microsoft linking from an already authenticated Waypoint account."
      }
    },
    {
      "name": "08 - Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{jwt}}" } ],
        "url": "{{baseUrl}}/api/v1/auth/logout",
        "description": "Revokes Waypoint sessions but intentionally preserves any Microsoft account link. Sign in with Microsoft again to verify it maps to the same Waypoint account."
      }
    },
    {
      "name": "09 - Explicit Microsoft Disconnect",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{jwt}}" } ],
        "url": "{{baseUrl}}/api/v1/auth/microsoft",
        "description": "Explicitly removes the Microsoft provider credential/link. Because Logout revokes the current JWT, obtain a fresh Waypoint session before running this request."
      }
    }
  ]
}
