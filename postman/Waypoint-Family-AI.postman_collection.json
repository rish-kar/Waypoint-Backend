{
  "info": {
    "_postman_id": "c8116d78-8d31-49a5-a2d7-6420f97d7730",
    "name": "Waypoint Backend - Friends & Family AI",
    "description": "Focused checks for Premium Special / Friends & Family AI. Personal requests expose only the signed-in user's abstract quota. The admin request exposes the complete pool and every Special grant user's account, grant and usage details.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Current Subscription",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Subscription payload is present', () => pm.expect(body).to.be.an('object'));",
              "pm.environment.set('familyAiCurrentPlan', String(body.plan || ''));",
              "pm.environment.set('familyAiSubscriptionStatus', String(body.status || ''));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "X-Request-ID", "value": "postman-family-ai-subscription" }
        ],
        "url": "{{baseUrl}}/api/v1/subscriptions/current",
        "description": "Confirms which subscription/plan the authenticated account currently receives. Premium Special should be returned for an active Friends & Family grant."
      }
    },
    {
      "name": "02 - Personal Friends & Family AI Usage",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Personal quota shape is valid', () => {",
              "    pm.expect(body.specialAccess).to.be.a('boolean');",
              "    pm.expect(body.requestTokenLimit).to.be.a('number');",
              "    pm.expect(body.monthlyAllowanceMicrorupees).to.be.a('number');",
              "    pm.expect(body.spentMicrorupees).to.be.a('number');",
              "    pm.expect(body.remainingMicrorupees).to.be.a('number');",
              "    pm.expect(body.usagePercent).to.be.a('number');",
              "    pm.expect(body.periodKey).to.match(/^\\d{4}-\\d{2}$/);",
              "    pm.expect(body.resetsAt).to.be.a('string').and.not.empty;",
              "    pm.expect(['ACTIVE', 'LIMIT_REACHED', 'NOT_SPECIAL']).to.include(body.status);",
              "});",
              "pm.test('Personal response does not expose pool or other users', () => {",
              "    pm.expect(body).to.not.have.property('monthlyPoolMicrorupees');",
              "    pm.expect(body).to.not.have.property('activeSpecialUsers');",
              "    pm.expect(body).to.not.have.property('users');",
              "});",
              "if (body.specialAccess) {",
              "    pm.expect(body.requestTokenLimit).to.eql(5000);",
              "    pm.expect(body.monthlyAllowanceMicrorupees).to.be.above(0);",
              "}",
              "pm.environment.set('familyAiSpecialAccess', String(body.specialAccess));",
              "pm.environment.set('familyAiRequestTokenLimit', String(body.requestTokenLimit));",
              "pm.environment.set('familyAiAllowanceRupees', String(body.monthlyAllowanceMicrorupees / 1000000));",
              "pm.environment.set('familyAiSpentRupees', String(body.spentMicrorupees / 1000000));",
              "pm.environment.set('familyAiRemainingRupees', String(body.remainingMicrorupees / 1000000));",
              "pm.environment.set('familyAiUsagePercent', String(body.usagePercent));",
              "pm.environment.set('familyAiResetsAt', String(body.resetsAt));",
              "pm.environment.set('familyAiStatus', String(body.status));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Accept", "value": "application/json" },
          { "key": "X-Request-ID", "value": "postman-family-ai-usage" }
        ],
        "url": "{{baseUrl}}/api/v1/ai/family-usage",
        "description": "Returns only the authenticated user's abstract Friends & Family quota. It intentionally hides the configured shared pool, active Special-user count and all other users."
      }
    },
    {
      "name": "03 - General AI Usage",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('General AI entitlement is exposed', () => pm.expect(body.cloudAiAllowed).to.be.a('boolean'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "X-Request-ID", "value": "postman-general-ai-usage" }
        ],
        "url": "{{baseUrl}}/api/v1/ai/usage",
        "description": "Shows the normal Cloud AI entitlement/trial usage alongside the separate Friends & Family quota endpoint."
      }
    },
    {
      "name": "04 - Admin Full Family AI Pool",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let CryptoJS;",
              "try { CryptoJS = pm.require('npm:crypto-js@4.2.0'); } catch (error) { CryptoJS = require('crypto-js'); }",
              "const adminId = pm.environment.get('adminId');",
              "const adminPassword = pm.environment.get('adminPassword');",
              "if (!adminId || !adminPassword) throw new Error('Set adminId and adminPassword in the Waypoint Local environment.');",
              "pm.environment.set('adminBasicAuth', CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(`${adminId}:${adminPassword}`)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Admin receives the complete Family AI pool', () => {",
              "    pm.expect(body.monthlyPoolMicrorupees).to.be.a('number').and.above(0);",
              "    pm.expect(body.poolSpentMicrorupees).to.be.a('number').and.at.least(0);",
              "    pm.expect(body.poolRemainingMicrorupees).to.be.a('number').and.at.least(0);",
              "    pm.expect(body.poolUsagePercent).to.be.a('number').and.within(0, 100);",
              "    pm.expect(body.activeSpecialUsers).to.be.a('number').and.at.least(0);",
              "    pm.expect(body.requestTokenLimit).to.eql(5000);",
              "    pm.expect(body.users).to.be.an('array');",
              "});",
              "pm.test('Admin receives complete per-user and grant details', () => {",
              "    body.users.forEach(user => {",
              "        ['grantId','userId','email','provider','providerUserId','persistedPlan','userCreatedAt','userUpdatedAt','lastLoginAt','active','reason','grantedBy','grantedAt','monthlyAllowanceMicrorupees','spentMicrorupees','remainingMicrorupees','usagePercent','status'].forEach(key => pm.expect(user).to.have.property(key));",
              "        pm.expect(['ACTIVE', 'LIMIT_REACHED', 'EXPIRED', 'REVOKED']).to.include(user.status);",
              "    });",
              "});",
              "pm.environment.set('familyAiAdminPoolRupees', String(body.monthlyPoolMicrorupees / 1000000));",
              "pm.environment.set('familyAiAdminPoolSpentRupees', String(body.poolSpentMicrorupees / 1000000));",
              "pm.environment.set('familyAiAdminPoolRemainingRupees', String(body.poolRemainingMicrorupees / 1000000));",
              "pm.environment.set('familyAiAdminActiveUsers', String(body.activeSpecialUsers));",
              "pm.environment.set('familyAiAdminUserCount', String(body.users.length));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Basic {{adminBasicAuth}}" },
          { "key": "Accept", "value": "application/json" },
          { "key": "X-Request-ID", "value": "postman-admin-family-ai-usage" }
        ],
        "url": "{{baseUrl}}/api/v1/admin/family-ai",
        "description": "Admin-only complete pool view: configured pool, total usage, remaining budget, active user count and every Special grant user's account, grant and usage details. Production also uses the collection's existing admin TOTP setup."
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) throw new Error('Select the Waypoint Local environment.');"
        ]
      }
    }
  ]
}
