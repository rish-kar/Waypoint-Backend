{
  "info": {
    "_postman_id": "c8116d78-8d31-49a5-a2d7-6420f97d7730",
    "name": "Waypoint Backend - Friends & Family AI",
    "description": "Focused checks for Premium Special / Friends & Family AI. Users see only Session (5hr), Weekly (7 day), reset times and the request token cap. Admin sees the complete monetary pool and per-user rolling usage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Current Subscription",
      "event": [{
        "listen": "test",
        "script": {"type": "text/javascript", "exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.environment.set('familyAiCurrentPlan', String(body.plan || ''));",
          "pm.environment.set('familyAiSubscriptionStatus', String(body.status || ''));"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt}}"},
          {"key": "X-Request-ID", "value": "postman-family-ai-subscription"}
        ],
        "url": "{{baseUrl}}/api/v1/subscriptions/current"
      }
    },
    {
      "name": "02 - Personal Friends & Family AI Usage",
      "event": [{
        "listen": "test",
        "script": {"type": "text/javascript", "exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.test('Only abstract rolling limits are exposed', () => {",
          "  pm.expect(body.specialAccess).to.be.a('boolean');",
          "  pm.expect(body.requestTokenLimit).to.be.a('number');",
          "  pm.expect(body.sessionWindowHours).to.eql(5);",
          "  pm.expect(body.sessionUsagePercent).to.be.a('number').and.within(0,100);",
          "  pm.expect(body.weeklyWindowDays).to.eql(7);",
          "  pm.expect(body.weeklyUsagePercent).to.be.a('number').and.within(0,100);",
          "  ['monthlyAllowanceRupees','spentRupees','remainingRupees','monthlyPoolRupees','poolSpentRupees','poolRemainingRupees','activeSpecialUsers','periodKey','resetsAt','users'].forEach(k => pm.expect(body).to.not.have.property(k));",
          "});",
          "if (body.specialAccess) {",
          "  pm.expect(body.requestTokenLimit).to.eql(5000);",
          "  pm.expect(body.sessionResetsAt).to.be.a('string').and.not.empty;",
          "  pm.expect(body.weeklyResetsAt).to.be.a('string').and.not.empty;",
          "}",
          "pm.environment.set('familyAiSessionUsagePercent', String(body.sessionUsagePercent));",
          "pm.environment.set('familyAiSessionResetsAt', String(body.sessionResetsAt || ''));",
          "pm.environment.set('familyAiWeeklyUsagePercent', String(body.weeklyUsagePercent));",
          "pm.environment.set('familyAiWeeklyResetsAt', String(body.weeklyResetsAt || ''));",
          "pm.environment.set('familyAiStatus', String(body.status));"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt}}"},
          {"key": "Accept", "value": "application/json"},
          {"key": "X-Request-ID", "value": "postman-family-ai-usage"}
        ],
        "url": "{{baseUrl}}/api/v1/ai/family-usage",
        "description": "User-facing abstract usage only: Session (5hr), Weekly (7 day), reset times and 5,000-token request cap."
      }
    },
    {
      "name": "03 - General AI Usage",
      "event": [{
        "listen": "test",
        "script": {"type": "text/javascript", "exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.test('General AI entitlement is exposed', () => pm.expect(body.cloudAiAllowed).to.be.a('boolean'));"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{jwt}}"},
          {"key": "X-Request-ID", "value": "postman-general-ai-usage"}
        ],
        "url": "{{baseUrl}}/api/v1/ai/usage"
      }
    },
    {
      "name": "04 - Admin Full Family AI Pool",
      "event": [
        {
          "listen": "prerequest",
          "script": {"type": "text/javascript", "exec": [
            "let CryptoJS;",
            "try { CryptoJS = pm.require('npm:crypto-js@4.2.0'); } catch (error) { CryptoJS = require('crypto-js'); }",
            "const adminId = pm.environment.get('adminId');",
            "const adminPassword = pm.environment.get('adminPassword');",
            "if (!adminId || !adminPassword) throw new Error('Set adminId and adminPassword in the Waypoint Local environment.');",
            "pm.environment.set('adminBasicAuth', CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(`${adminId}:${adminPassword}`)));"
          ]}
        },
        {
          "listen": "test",
          "script": {"type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Admin gets full pool and rolling configuration', () => {",
            "  pm.expect(body.monthlyPoolRupees).to.be.a('number').and.above(0);",
            "  pm.expect(body.poolSpentRupees).to.be.a('number').and.at.least(0);",
            "  pm.expect(body.poolRemainingRupees).to.be.a('number').and.at.least(0);",
            "  pm.expect(body.activeSpecialUsers).to.be.a('number').and.at.least(0);",
            "  pm.expect(body.sessionWindowHours).to.eql(5);",
            "  pm.expect(body.sessionBudgetPercent).to.be.a('number').and.above(0);",
            "  pm.expect(body.weeklyWindowDays).to.eql(7);",
            "  pm.expect(body.weeklyBudgetPercent).to.be.a('number').and.above(0);",
            "  pm.expect(body.users).to.be.an('array');",
            "});",
            "pm.test('Admin gets complete per-user rolling stats', () => {",
            "  body.users.forEach(user => {",
            "    ['monthlyAllowanceRupees','spentRupees','remainingRupees','sessionLimitRupees','sessionSpentRupees','sessionRemainingRupees','weeklyLimitRupees','weeklySpentRupees','weeklyRemainingRupees'].forEach(k => pm.expect(user[k]).to.be.a('number').and.at.least(0));",
            "    ['usagePercent','sessionUsagePercent','weeklyUsagePercent'].forEach(k => pm.expect(user[k]).to.be.a('number').and.within(0,100));",
            "    ['monthlyRequestCount','monthlyInputTokens','sessionRequestCount','sessionInputTokens','weeklyRequestCount','weeklyInputTokens'].forEach(k => pm.expect(user[k]).to.be.a('number').and.at.least(0));",
            "  });",
            "});",
            "pm.environment.set('familyAiAdminPoolRupees', String(body.monthlyPoolRupees));",
            "pm.environment.set('familyAiAdminPoolSpentRupees', String(body.poolSpentRupees));",
            "pm.environment.set('familyAiAdminPoolRemainingRupees', String(body.poolRemainingRupees));",
            "pm.environment.set('familyAiAdminSessionBudgetPercent', String(body.sessionBudgetPercent));",
            "pm.environment.set('familyAiAdminWeeklyBudgetPercent', String(body.weeklyBudgetPercent));",
            "pm.environment.set('familyAiAdminUserCount', String(body.users.length));"
          ]}
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Basic {{adminBasicAuth}}"},
          {"key": "Accept", "value": "application/json"},
          {"key": "X-Request-ID", "value": "postman-admin-family-ai-usage"}
        ],
        "url": "{{baseUrl}}/api/v1/admin/family-ai",
        "description": "Admin-only complete monthly pool plus per-user monthly, 5-hour and weekly usage, request counts and token counts."
      }
    }
  ],
  "event": [{
    "listen": "prerequest",
    "script": {"type": "text/javascript", "exec": [
      "if (!pm.environment.get('baseUrl')) throw new Error('Select the Waypoint Local environment.');",
      "const requestUrl = pm.request.url.toString();",
      "const adminTotp = String(pm.environment.get('adminTotp') || '').trim();",
      "if (adminTotp && requestUrl.includes('/api/v1/admin/')) pm.request.headers.upsert({ key: 'X-Admin-TOTP', value: adminTotp });",
      "else pm.request.headers.remove('X-Admin-TOTP');"
    ]}
  }]
}
